# Root level ignores
.env
*.env.local
*.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Dependencies
node_modules/

# Docker override
docker-compose.override.yml

# graphify: keep the queryable graph (graph.json) + docs (GRAPH_REPORT.md, wiki),
# but ignore the heavy regenerable artifacts that bloat every push —
# the AST cache, the standalone HTML viewer, and the dated backup snapshots.
graphify-out/cache/
graphify-out/*.html
graphify-out/20*/
